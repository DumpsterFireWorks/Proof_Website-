{
  "name": "proof-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "browser:verify": "node scripts/browser-verify.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-site.mjs",
    "check": "npm run typecheck && npm run validate",
    "verify": "npm run check && npm run build && node scripts/validate-site.mjs --dist"
  },
  "devDependencies": {
    "playwright-core": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
